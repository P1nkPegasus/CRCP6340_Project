<div class="card m-2 h-100 fadein" >
    <img src="<%= image %>" card-img-top" alt="An image of the <%= name %> project">
    <div class="card-body">
        <h2 class="card-title">
            <%= name %>
        </h2>
        <p class="card-text">
            <%= projectDescription %>
        </p>
        <ul class="list-group list-group-flush">
            <% if (typeof quantity !== 'undefined') { %>
              <li class="list-group-item">Quantity: <%= quantity %></li>
            <% } %>
            <% if (typeof price !== 'undefined') { %>
              <li class="list-group-item">Price (ETH): <%= price %></li>
            <% } %>
            <% if (typeof open !== 'undefined') { %>
              <li class="list-group-item">Open Date (GMT): <%= open %></li>
            <% } %>
            <% if (typeof royalty !== 'undefined') { %>
              <li class="list-group-item">Royalty Percent: <%= royalty %></li>
            <% } %>
            <% if (typeof active !== 'undefined') { %>
              <li class="list-group-item">Active: <%= active ? 'Yes' : 'No' %></li>
            <% } %>
          </ul>
    </div>

    <div class="card-footer">
      <% if (typeof context !== 'undefined') { %>

        <% if (context === 'index' || context === 'projects') { %>
          <a href="/project/<%= id %>" class="btn btn-primary">
            <%= name %>'s profile
          </a> 
        <% } else if (context === 'project') { %>
          <button class="btn btn-primary">Mint Me!</button>
        <% } %>
      <% } %>
    
    </div>
</div>