<!DOCTYPE html>
<html lang="en">

<%- include ('head'); %>
<%- include ('navbar'); %>

    <body>
      <div class="text-center m-3">
        <h1>Let's Connect!</h1>
      </div>
      <!-- TODO add floating labels instead for visual and check tabbing access. -->
      <form id="contactForm" class="needs-validation">
        <div class="row m-5">
          <div class="col">
            <input id="firstName" class="form-control" type="text" placeholder="First name" aria-label="First name"
              required />
          </div>

          <div class="col">
            <input id="lastName" class="form-control" type="text" placeholder="Last name" aria-label="Last name"
              required />
          </div>
        </div>

        <div class="row m-5">
          <div class="mb-3">
            <input id="email" class="form-control" type="email" aria-describedby="emailHelp" placeholder="Enter email"
              required />
            <div id="emailFeedback" class="invalid-feedback">
              Please enter valid email. ie. example@example.com
            </div>
            <div id="emailHelp" class="form-text">
              We'll never share your email with anyone else.
            </div>
          </div>
        </div>

        <div class="row m-5">
          <div class="mb-3">
            <textarea id="message" class="form-control" type="text" placeholder="Enter your message" rows="3"
              required></textarea>
            <div id="messageFeedback" class="invalid-feedback">
              Please enter a message.
            </div>
          </div>
        </div>

        <div class="text-center">
          <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <symbol id="check-circle-fill" viewBox="0 0 16 16">
              <path
                d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </symbol>
            <symbol id="exclamation-triangle-fill" viewBox="0 0 16 16">
              <path
                d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
            </symbol>
          </svg>
          <div id="liveAlertPlaceholder"></div>
          <div></div>
          <button id="contactFormBtn" type="submit" class="btn btn-primary text-center">
            Submit
          </button>
        </div>
      </form>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
        crossorigin="anonymous"></script>
      <script type="module" src="./js/contact.js"></script>
      <script type="module" src="./js/index.js"></script>
      <%- include ('footer'); %>

    </body>

</html>