<!DOCTYPE html>
<html lang="en">
<%- include ('head'); %>
  <%- include ('navbar'); %>

    <body>
      <%- include ('header'); %>
        <div class="container m-3">
          <h1>Projects</h1>
          <p>Here are some of my projects. Click on the links to see the code and a demo.</p>
          <% projectArray.forEach((item, index)=> { %>
            <div  id="projectCards" class="row" data-masonry='{"percentPosition": true }'>

              <%- include ('projectCard', { 
                id: item.id,
                image: item.img_url, 
                name: item.project_name,
                projectDescription: item.project_description,
                context: 'projects'
               }); %>
             
            </div>
            <% }); %>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
          crossorigin="anonymous"></script>
        <script type="module" src="./js/index.js"></script>
        <%- include ('footer'); %>
    </body>

</html>