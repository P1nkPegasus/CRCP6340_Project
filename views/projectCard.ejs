<div class="card m-2 h-100 fadein" style="width: 18rem;">
    <img src="<%= image %>"card-img-top" alt="An image of the <%= name %> project">
    <div class="card-body">
        <h5 class="card-title">
            <%= name %>
        </h5>
        <p class="card-text">
            <%= description %>
        </p>
    </div>

    <div class="card-footer">
        <a href="/project/<%= id %>" class="btn btn-primary"> <%= name %>'s profile</a>
    </div>
</div>